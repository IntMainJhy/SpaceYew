# Node.js 24.15+；数据目录应放在应用发布目录以外。
APP_DATA_DIR=/var/lib/personal-site
PUBLIC_URL=https://your-domain.example
COOKIE_SECURE=true
# 仅在可信 Nginx 代理覆盖 X-Real-IP 时开启。
TRUST_PROXY=false
MAX_FILE_BYTES=10000000000
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_EXPIRE_DAYS=7
ANALYTICS_RETENTION_DAYS=180
# application 统计文件响应流字节；nginx 需要运行日志导入脚本。
TRAFFIC_SOURCE=application

# SMTP发送验证邮件。465使用TLS，587强制STARTTLS；不要将密码提交到源码。
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 仅本机联调可显式设置MAIL_MODE=capture；不发邮件，验证码写入私有数据目录mail-outbox。
# capture在PUBLIC_URL或请求不是loopback时拒绝启用。

# 双入口部署使用 deploy/platform.env.example 与 deploy/admin.env.example。
# APP_SURFACE=platform|admin；未配置时保持现有 combined 兼容模式。
# 平台体验登录：PLATFORM_LOGIN_MODE=experience；不创建正式账号。
# REGISTRATION_ENABLED=false
# PLATFORM_URL=https://app.example.com
# ADMIN_URL=https://admin.example.com

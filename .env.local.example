# Local loopback development only. Keep this URL identical to the browser address.
PUBLIC_URL=http://127.0.0.1:3008
COOKIE_SECURE=false

# Local email registration. Production publishing remains separately gated.
REGISTRATION_ENABLED=true
# QQ SMTP: use the complete mailbox address and its SMTP authorization code.
MAIL_MODE=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

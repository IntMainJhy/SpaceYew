# 放在 Nginx http 上下文（例如 sites-enabled 文件）；替换域名与证书路径。
log_format spaceyew_access escape=json '{"id":"$request_id","at":"$time_iso8601","ip":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes":$body_bytes_sent}';
log_format spaceyew_files escape=json '{"id":"$request_id","at":"$time_iso8601","path":"$uri","bytes":$body_bytes_sent}';
map $uri $spaceyew_file_request { default 0; ~^/(download|media)/[a-f0-9-]+$ 1; }

limit_req_zone $binary_remote_addr zone=spaceyew_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=spaceyew_connections:10m;

# 两个子域名各自反向代理；不代理到对方的端口。
server {
    listen 80;
    server_name app.example.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/spaceyew-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name app.example.com;
    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    client_max_body_size 17m;
    client_body_timeout 120s;
    server_tokens off;
    limit_req zone=spaceyew_requests burst=80 nodelay;
    limit_req_status 429;
    limit_conn spaceyew_connections 30;
    keepalive_timeout 30s;
    location ~ /(?:\.env(?:\.[^/]*)?|\.git|node_modules)(?:/|$) { return 404; }
    location ~ \.(?:sqlite(?:-wal|-shm)?|map|bak)$ { return 404; }
    access_log /var/log/nginx/spaceyew-access.json spaceyew_access;
    access_log /var/log/nginx/spaceyew-files.json spaceyew_files if=$spaceyew_file_request;
    location / {
        proxy_pass http://127.0.0.1:3008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        send_timeout 600s;
    }
}

server {
    listen 80;
    server_name admin.example.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/spaceyew-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name admin.example.com;
    ssl_certificate /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;
    client_max_body_size 17m;
    client_body_timeout 120s;
    server_tokens off;
    limit_req zone=spaceyew_requests burst=80 nodelay;
    limit_req_status 429;
    limit_conn spaceyew_connections 30;
    keepalive_timeout 30s;
    location ~ /(?:\.env(?:\.[^/]*)?|\.git|node_modules)(?:/|$) { return 404; }
    location ~ \.(?:sqlite(?:-wal|-shm)?|map|bak)$ { return 404; }
    access_log /var/log/nginx/spaceyew-access.json spaceyew_access;
    access_log /var/log/nginx/spaceyew-files.json spaceyew_files if=$spaceyew_file_request;
    location / {
        proxy_pass http://127.0.0.1:3009;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        send_timeout 600s;
    }
}

# 放在 Nginx http 上下文（例如 sites-enabled 文件）；替换域名与证书路径。
log_format personal_files escape=json '{"id":"$request_id","at":"$time_iso8601","path":"$uri","bytes":$body_bytes_sent}';
map $uri $personal_file_request { default 0; ~^/(download|media)/[a-f0-9-]+$ 1; }

limit_req_zone $binary_remote_addr zone=personal_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=personal_connections:10m;

server {
    listen 80;
    server_name your-domain.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name your-domain.example;
    ssl_certificate /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
    client_max_body_size 17m;
    client_body_timeout 120s;
    server_tokens off;
    limit_req zone=personal_requests burst=80 nodelay;
    limit_req_status 429;
    limit_conn personal_connections 30;
    keepalive_timeout 30s;
    location ~ /(?:\.env(?:\.[^/]*)?|\.git|node_modules)(?:/|$) { return 404; }
    location ~ \.(?:sqlite(?:-wal|-shm)?|map|bak)$ { return 404; }
    access_log /var/log/nginx/personal-files.json personal_files if=$personal_file_request;
    location / {
        proxy_pass http://127.0.0.1:3008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        send_timeout 600s;
    }
}

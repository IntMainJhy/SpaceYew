{
  "name": "spaceyew-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prebuild": "node scripts/package-skill.mjs",
    "package:skill": "node scripts/package-skill.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3008",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3008",
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node test/integration.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "typecheck": "tsc --noEmit",
    "test:community:http": "node test/community-http.mjs",
    "demo": "node scripts/demo.mjs",
    "test:homepage:http": "node test/blog-http.mjs",
    "test:skills:http": "node test/skills-http.mjs"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "gsap": "3.15.0",
    "next": "15.5.28",
    "nodemailer": "10.1.7",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.30"
  },
